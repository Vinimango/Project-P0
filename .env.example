OLLAMA_TIMEOUT=300

# Set to true only when the Ollama endpoint requires authentication.
OLLAMA_REQUIRE_AUTH=false
OLLAMA_API_KEY=

# Configurable parameters
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_PREDICT=100
OLLAMA_TOP_P=1.0
